---
import { url } from "../../lib/url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostCard from "../../components/PostCard.astro";
import { categories, posts } from "../../data/posts";

const title = "Blog FlowTImeAi — planowanie, kalendarze i AI";
const description = "Praktyczne teksty o spokojnym planowaniu czasu, produktywności, kalendarzach i roli AI w codziennym rytmie.";
---

<BaseLayout {title} {description} canonicalPath="/blog/" ogImage="/assets/blog-week.svg">
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <Header active="blog" />
  <main id="main">
    <section class="blog-hero" id="top">
      <div class="container-xl"><span class="eyebrow"><span class="eyebrow-dot"></span> Blog FlowTImeAi</span><h1>Więcej spokoju w <span>Twoim kalendarzu.</span></h1><p>Notatki o planowaniu czasu, energii i inteligentnych narzędziach, które zostawiają przestrzeń na ważne sprawy.</p></div>
    </section>

    <section class="blog-archive section" aria-label="Archiwum publikacji">
      <div class="container-xl">
        <div class="row gy-5 gx-0 gx-lg-5">
          <div class="col-lg-8">
            <div class="blog-section-heading"><h2>Najnowsze publikacje</h2><p id="blogCount" role="status" aria-live="polite">{posts.length} artykułów o lepszym rytmie pracy i odpoczynku.</p></div>
            <div class="row g-4" id="blogGrid">
              {posts.map((post) => (
                <div class="col-md-6 blog-item-col" data-category={post.category} data-search={`${post.title} ${post.description} ${post.category} ${post.tags.join(" ")}`.toLowerCase()} data-datetime={post.datetime}>
                  <PostCard post={post} />
                </div>
              ))}
            </div>
            <p class="shop-empty" id="blogEmpty" hidden>Brak artykułów spełniających kryteria. Zmień wyszukiwanie lub kategorię.</p>
            <nav class="mt-5" aria-label="Strony archiwum bloga" id="blogPagination" hidden><ul class="pagination justify-content-center"></ul></nav>
          </div>
          <aside class="col-lg-4 blog-sidebar" aria-label="Narzędzia bloga">
            <div class="blog-side-card"><h2 class="blog-side-title">Szukaj w blogu</h2><form class="blog-search" action={url("/blog/")} method="get"><label class="visually-hidden" for="blog-search">Szukaj artykułów</label><input class="form-control" id="blog-search" name="q" type="search" placeholder="Np. plan tygodnia" /><button class="btn btn-primary" type="submit" aria-label="Szukaj w blogu"><span aria-hidden="true">⌕</span> Szukaj</button></form></div>
            <div class="blog-side-card"><h2 class="blog-side-title">Kategorie</h2><ul class="blog-category-list" id="blogCategories"><li><button type="button" class="blog-category-btn active" data-category="" aria-pressed="true">Wszystkie <span class="badge">{posts.length}</span></button></li>{categories.map((c) => <li><button type="button" class="blog-category-btn" data-category={c.name} aria-pressed="false">{c.name} <span class="badge">{c.count}</span></button></li>)}</ul></div>
            <div class="blog-side-card"><h2 class="blog-side-title">Polecamy</h2><div class="recommended-list">{posts.slice(1, 4).map((post) => <a class="recommended-post" href={url(`/blog/${post.slug}/`)}><img src={url(post.image)} width="120" height="72" loading="lazy" decoding="async" alt={post.imageAlt} /><span><strong>{post.title}</strong><small>{post.readingTime}</small></span></a>)}</div></div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
