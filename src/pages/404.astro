---
import { url } from "../lib/url";
import { searchIndex } from "../lib/search-index";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="Nie znaleziono strony — FlowTImeAi" description="Szukana strona nie istnieje. Skorzystaj z wyszukiwarki lub wróć do strony głównej." noindex>
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <Header />
  <main id="main" class="error-page d-flex flex-column align-items-center justify-content-center">
    <div class="container-xl d-flex flex-column align-items-center justify-content-center">
      <p class="error-code" aria-hidden="true">404</p>
      <h1>Nie znaleziono strony</h1>
      <p>Strona, której szukasz, mogła zostać przeniesiona lub usunięta. Sprawdź, czy adres został wpisany poprawnie, albo skorzystaj z wyszukiwarki poniżej.</p>
      <form class="error-search" role="search" id="siteSearch" action={url("/blog/")} >
        <label class="visually-hidden" for="siteSearchInput">Szukaj w serwisie</label>
        <div class="input-group">
          <input class="form-control" type="search" id="siteSearchInput" placeholder="Szukaj w serwisie…" autocomplete="off" />
          <button class="btn btn-primary" type="submit">Szukaj</button>
        </div>
      </form>
      <ul class="search-results" id="siteSearchResults" aria-live="polite"></ul>
      <div class="error-actions">
        <a class="btn btn-primary" href={url("/")}>Wróć do strony głównej</a>
        <a class="btn btn-outline-primary" href={url("/sklep/")}>Przejdź do sklepu</a>
        <a class="btn btn-outline-primary" href={url("/kontakt/")}>Skontaktuj się z nami</a>
      </div>
    </div>
    <script type="application/json" id="siteSearchIndex" set:html={JSON.stringify(searchIndex)}></script>
  </main>
  <Footer />
</BaseLayout>
