---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { posts } from "../data/posts";
---

<BaseLayout>
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <Header active="home" />

  <main id="main">
    <section class="hero-section" id="top">
      <div class="container-xl">
        <div class="row align-items-center gy-5 gx-0 gx-lg-5">
          <div class="col-lg-6 hero-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span> Twój czas. Twój rytm.</span>
            <h1>Dzień, który <span>układa się po Twojemu</span></h1>
            <p class="hero-lead">Spotkania, zadania i czas dla siebie — w jednym inteligentnym kalendarzu. FlowTImeAi ułatwia planowanie i zostawia przestrzeń na życie.</p>
            <div class="hero-actions">
              <a class="btn btn-primary btn-lg" href="#early-access">Zacznij za darmo <span aria-hidden="true">→</span></a>
              <a class="text-link" href="#how-it-works"><span class="play-icon" aria-hidden="true">▶</span> Zobacz, jak to działa</a>
            </div>
            <div class="social-proof"><div class="avatar-stack" aria-hidden="true"><span>A</span><span>M</span><span>I</span><span>+</span></div><p><strong>Dołączają do nas</strong><br />osoby, które cenią swój czas</p></div>
          </div>
          <div class="col-lg-6 hero-visual">
            <div class="visual-glow" aria-hidden="true"></div>
            <img class="calendar-preview img-fluid" src="/assets/calendar-preview.svg" alt="Interfejs FlowTImeAi: tygodniowy kalendarz z kolorowymi spotkaniami, zadaniami i zaplanowanym czasem dla siebie" width="660" height="500" loading="eager" fetchpriority="high" decoding="async" />
            <div class="floating-note note-focus"><span class="note-icon focus-icon" aria-hidden="true">✦</span><span><strong>Czas dla siebie</strong><small>zarezerwowany w planie</small></span><span class="note-check" aria-hidden="true">✓</span></div>
            <div class="floating-note note-suggestion"><span class="suggestion-icon" aria-hidden="true">✧</span><span><strong>Masz czas na lunch</strong><small>12:30 · 45 minut</small></span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Najważniejsze korzyści">
      <div class="container-xl"><div class="trust-items"><div><span class="trust-icon red" aria-hidden="true">◷</span><span>Więcej przejrzystości</span></div><div><span class="trust-icon blue" aria-hidden="true">✦</span><span>Mniej rutyny</span></div><div><span class="trust-icon green" aria-hidden="true">♡</span><span>Równowaga na co dzień</span></div></div></div>
    </section>

    <section class="section features-section" id="features">
      <div class="container-xl">
        <div class="section-heading text-center"><span class="eyebrow">Planuj bez przeciążenia</span><h2>Porządek w zadaniach.<br /><span>Spokój w głowie.</span></h2><p>To coś więcej niż lista wydarzeń — to spokojny ogląd całego dnia.</p></div>
        <div class="row g-3 g-lg-4 feature-grid">
          <div class="col-md-6 col-lg-4"><article class="card feature-card feature-card-red h-100"><div class="card-body"><span class="feature-icon" aria-hidden="true">◷</span><h3 class="card-title">Wszystko w jednym miejscu</h3><p class="card-text">Zbierz spotkania, zadania i osobiste plany w jednym przejrzystym kalendarzu.</p><div class="mini-schedule" aria-hidden="true"><span class="mini-time">09:00</span><span class="mini-event mini-event-blue">Spotkanie zespołu</span><span class="mini-time">11:30</span><span class="mini-event mini-event-red">Czas na skupienie</span></div></div></article></div>
          <div class="col-md-6 col-lg-4"><article class="card feature-card feature-card-blue h-100"><div class="card-body"><span class="feature-icon" aria-hidden="true">✧</span><h3 class="card-title">Inteligentne podpowiedzi</h3><p class="card-text">Znajduj dogodny czas na ważne sprawy i pamiętaj o przerwach.</p><div class="insight-pill"><span aria-hidden="true">✦</span> Wygląda na to, że po 14:00 masz wolne</div></div></article></div>
          <div class="col-md-6 col-lg-4"><article class="card feature-card feature-card-green h-100"><div class="card-body"><span class="feature-icon" aria-hidden="true">♡</span><h3 class="card-title">Czas na życie</h3><p class="card-text">Planuj odpoczynek tak samo jak pracę. Równowaga zaczyna się w kalendarzu.</p><div class="balance-row"><span>Skupienie</span><span class="balance-track"><i></i></span><span>Odpoczynek</span></div></div></article></div>
        </div>
      </div>
    </section>

    <section class="section workflow-section" id="how-it-works">
      <div class="container-xl"><div class="row align-items-center gy-5 gx-0 gx-lg-5">
        <div class="col-lg-5"><span class="eyebrow">Łatwo zacząć</span><h2>Planuj mniej.<br /><span>Rób to, co ważne.</span></h2><p class="section-copy">FlowTImeAi zamienia listę zadań w realistyczny plan, który uwzględnia Twoje tempo.</p><a class="btn btn-outline-primary btn-lg" href="#early-access">Znajdź swój rytm <span aria-hidden="true">→</span></a></div>
        <div class="col-lg-7"><div class="steps-list">
          <article class="step-item"><span class="step-number">01</span><div><h3>Dodaj to, co ważne</h3><p>Dodaj spotkania, zadania i osobiste plany w kilka minut.</p></div><span class="step-art step-art-calendar" aria-hidden="true">▦</span></article>
          <article class="step-item"><span class="step-number">02</span><div><h3>Znajdź dogodny czas</h3><p>Inteligentne podpowiedzi pomogą rozłożyć obowiązki i znaleźć wolne chwile.</p></div><span class="step-art step-art-spark" aria-hidden="true">✧</span></article>
          <article class="step-item"><span class="step-number">03</span><div><h3>Zostaw czas dla siebie</h3><p>Zaplanuj odpoczynek i kończ dzień z poczuciem równowagi.</p></div><span class="step-art step-art-heart" aria-hidden="true">♡</span></article>
        </div></div>
      </div></div>
    </section>

    <section class="quote-section"><div class="container-xl"><div class="quote-card"><span class="quote-mark" aria-hidden="true">“</span><blockquote>Dobry plan nie rozpisuje każdej minuty. Zostawia w nim miejsce dla Ciebie.</blockquote><p>FlowTImeAi · inteligentny kalendarz dla ludzi</p><div class="quote-spark" aria-hidden="true">✦</div></div></div></section>

    <section class="section faq-section" id="faq"><div class="container-xl"><div class="section-heading text-center"><span class="eyebrow">Masz pytania?</span><h2>Krótko i konkretnie</h2></div><div class="accordion faq-accordion" id="faqAccordion">
      <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqOne" aria-expanded="true" aria-controls="faqOne">Czym jest FlowTImeAi?</button></h3><div id="faqOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion"><div class="accordion-body">To koncepcja inteligentnego kalendarza, który łączy wydarzenia, zadania i czas dla siebie, pomagając ogarnąć cały dzień.</div></div></div>
      <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTwo" aria-expanded="false" aria-controls="faqTwo">Czy usługa jest już dostępna?</button></h3><div id="faqTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion"><div class="accordion-body">Zbieramy osoby zainteresowane wczesnym dostępem. Zostaw adres e-mail w formularzu poniżej, aby dowiedzieć się o premierze.</div></div></div>
      <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqThree" aria-expanded="false" aria-controls="faqThree">Czy wczesny dostęp jest płatny?</button></h3><div id="faqThree" class="accordion-collapse collapse" data-bs-parent="#faqAccordion"><div class="accordion-body">Zgłoszenie do wczesnego dostępu jest bezpłatne. Warunki korzystania z produktu ogłosimy przed premierą.</div></div></div>
    </div></div></section>

    <section class="section blog-preview-section" aria-labelledby="blog-preview-title">
      <div class="container-xl">
        <div class="section-heading text-center">
          <span class="eyebrow">Z dziennika FlowTImeAi</span>
          <h2 id="blog-preview-title">Pomysły na spokojniejszy <span>plan dnia.</span></h2>
          <p>Praktyczne wskazówki o planowaniu, kalendarzach i AI, które pomaga odzyskać uwagę.</p>
        </div>
        <div class="row g-4">
          {posts.slice(0, 3).map((post) => (
            <div class="col-md-6 col-lg-4">
              <article class="card blog-card h-100">
                <img class="blog-card-image" src={post.image} width="720" height="430" loading="lazy" decoding="async" alt={post.imageAlt} />
                <div class="card-body d-flex flex-column">
                  <div class="blog-meta"><span class="badge blog-category">{post.category}</span><time datetime={post.datetime}>{post.date}</time></div>
                  <h3 class="blog-card-title">{post.title}</h3>
                  <p class="blog-card-text">{post.description}</p>
                  <a class="blog-read-link mt-auto" href="/blog/single/">Czytaj dalej <span aria-hidden="true">→</span></a>
                </div>
              </article>
            </div>
          ))}
        </div>
        <div class="text-center blog-preview-cta"><a class="btn btn-outline-primary btn-lg" href="/blog/">Zobacz wszystkie publikacje <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="cta-section" id="early-access"><div class="container-xl"><div class="cta-card"><div class="cta-content"><span class="eyebrow">Twój następny krok</span><h2>Niech dzień działa <span>na Twoją korzyść.</span></h2><p>Zostaw adres e-mail — damy Ci znać, gdy FlowTImeAi będzie gotowy.</p></div><form class="signup-form" id="signupForm"><label for="emailAddress">Adres e-mail</label><div class="input-group"><input class="form-control" type="email" id="emailAddress" name="email" placeholder="name@example.com" autocomplete="email" required aria-describedby="formHint formStatus" /><button class="btn btn-primary" type="submit">Chcę wypróbować <span aria-hidden="true">→</span></button></div><div class="form-meta"><span id="formHint">Bez spamu. Tylko informacje o premierze.</span><span id="formStatus" role="status" aria-live="polite"></span></div></form><div class="cta-orbit orbit-one" aria-hidden="true"></div><div class="cta-orbit orbit-two" aria-hidden="true"></div></div></div></section>
  </main>

  <Footer />
</BaseLayout>
