---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { posts } from "../data/posts";
import { products } from "../data/products";
---

<BaseLayout>
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <Header active="home" />

  <main id="main">
    <section class="hero-section" id="hero">
      <div class="container-xl" id="top">
        <div class="row align-items-center gy-5 gx-0 gx-lg-5">
          <div class="col-lg-6 hero-copy">
            <span class="eyebrow"><span class="eyebrow-dot"></span> Twój czas. Twój rytm.</span>
            <h1>FlowTImeAi — dzień, który <span>układa się po Twojemu</span></h1>
            <p class="hero-lead">Spotkania, zadania i czas dla siebie — w jednym inteligentnym kalendarzu. FlowTImeAi ułatwia planowanie dnia, pomaga chronić skupienie i zostawia przestrzeń na życie.</p>
            <div class="hero-actions">
              <a class="btn btn-primary btn-lg" href="#kontakt">Skontaktuj się z nami <span aria-hidden="true">→</span></a>
              <a class="text-link" href="#o-nas"><span class="play-icon" aria-hidden="true">▶</span> Poznaj naszą misję</a>
            </div>
            <div class="social-proof"><div class="avatar-stack" aria-hidden="true"><span>A</span><span>M</span><span>I</span><span>+</span></div><p><strong>Dołączają do nas</strong><br />osoby, które cenią swój czas</p></div>
          </div>
          <div class="col-lg-6 hero-visual">
            <div class="visual-glow" aria-hidden="true"></div>
            <img class="calendar-preview img-fluid" src="/assets/calendar-preview.svg" alt="Interfejs FlowTImeAi: tygodniowy kalendarz z kolorowymi spotkaniami, zadaniami i zaplanowanym czasem dla siebie" width="660" height="500" loading="eager" fetchpriority="high" decoding="async" />
            <div class="floating-note note-focus"><span class="note-icon focus-icon" aria-hidden="true">✦</span><span><strong>Czas dla siebie</strong><small>zarezerwowany w planie</small></span><span class="note-check" aria-hidden="true">✓</span></div>
            <div class="floating-note note-suggestion"><span class="suggestion-icon" aria-hidden="true">✧</span><span><strong>Masz czas na lunch</strong><small>12:30 · 45 minut</small></span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Najważniejsze korzyści">
      <div class="container-xl"><div class="trust-items"><div><span class="trust-icon red" aria-hidden="true">◷</span><span>Więcej przejrzystości</span></div><div><span class="trust-icon blue" aria-hidden="true">✦</span><span>Mniej rutyny</span></div><div><span class="trust-icon green" aria-hidden="true">♡</span><span>Równowaga na co dzień</span></div></div></div>
    </section>

    <section class="section workflow-section" id="o-nas">
      <div class="container-xl">
        <div class="row align-items-center gy-5 gx-0 gx-lg-5" id="how-it-works">
          <div class="col-lg-6">
            <span class="eyebrow">O inicjatywie FlowTImeAi</span>
            <h2>Planuj mniej.<br /><span>Rób to, co ważne.</span></h2>
            <p class="section-copy">FlowTImeAi to inicjatywa projektowa tworząca narzędzia spokojnego planowania czasu. Naszą misją jest zastąpienie przeładowanych list zadań czytelnym kalendarzem, który łączy obowiązki zawodowe, naukę oraz regenerację w jednym rytmie.</p>
            <div class="steps-list mt-4">
              <article class="step-item"><span class="step-number">01</span><div><h3>Dodaj to, co ważne</h3><p>Zbierz spotkania, zadania i osobiste plany w kilka minut w jednym widoku.</p></div><span class="step-art step-art-calendar" aria-hidden="true">▦</span></article>
              <article class="step-item"><span class="step-number">02</span><div><h3>Znajdź dogodny czas</h3><p>Inteligentne podpowiedzi AI pomagają rozłożyć obowiązki i znaleźć wolne chwile.</p></div><span class="step-art step-art-spark" aria-hidden="true">✧</span></article>
              <article class="step-item"><span class="step-number">03</span><div><h3>Zostaw czas dla siebie</h3><p>Zaplanuj odpoczynek i kończ dzień z poczuciem spokoju oraz równowagi.</p></div><span class="step-art step-art-heart" aria-hidden="true">♡</span></article>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="about-visual-card">
              <img class="img-fluid rounded-4" src="/assets/blog-week.svg" width="720" height="430" loading="lazy" decoding="async" alt="Widok harmonijnego planu tygodnia w metodologii FlowTImeAi" />
              <div class="about-visual-caption">
                <strong>Spokojna architektura tygodnia</strong>
                <span>Łączymy przejrzystość klasycznego kalendarza z nieinwazyjnymi podpowiedziami AI.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section features-section" id="oferta">
      <div class="container-xl" id="features">
        <div class="section-heading text-center"><span class="eyebrow">Kluczowa oferta</span><h2>Porządek w zadaniach.<br /><span>Spokój w głowie.</span></h2><p>Trzy główne filary ekosystemu FlowTImeAi — od inteligentnego kalendarza po gotowe pakiety wdrożeniowe.</p></div>
        <div class="row g-3 g-lg-4 feature-grid">
          <div class="col-md-6 col-lg-4"><article class="card feature-card feature-card-red h-100"><div class="card-body d-flex flex-column"><span class="feature-icon" aria-hidden="true">◷</span><h3 class="card-title">Inteligentny kalendarz dnia</h3><p class="card-text">Zbierz spotkania, zadania i osobiste plany w jednym przejrzystym kalendarzu tygodniowym.</p><div class="mini-schedule mb-3" aria-hidden="true"><span class="mini-time">09:00</span><span class="mini-event mini-event-blue">Spotkanie zespołu</span><span class="mini-time">11:30</span><span class="mini-event mini-event-red">Czas na skupienie</span></div><a class="blog-read-link mt-auto" href="/sklep/plan-osobisty-ai/">Zobacz plan Personal <span aria-hidden="true">→</span></a></div></article></div>
          <div class="col-md-6 col-lg-4"><article class="card feature-card feature-card-blue h-100"><div class="card-body d-flex flex-column"><span class="feature-icon" aria-hidden="true">✧</span><h3 class="card-title">Asystent i warsztaty AI</h3><p class="card-text">Korzystaj z podpowiedzi AI oraz praktycznych materiałów o planowaniu czasu bez presji.</p><div class="insight-pill mb-3"><span aria-hidden="true">✦</span> Wygląda na to, że po 14:00 masz wolne</div><a class="blog-read-link mt-auto" href="/sklep/warsztat-planowania-ai/">Sprawdź kurs i narzędzia <span aria-hidden="true">→</span></a></div></article></div>
          <div class="col-md-6 col-lg-4"><article class="card feature-card feature-card-green h-100"><div class="card-body d-flex flex-column"><span class="feature-icon" aria-hidden="true">♡</span><h3 class="card-title">Szablony i pakiety zespołowe</h3><p class="card-text">Wdróż gotowe szablony tygodnia oraz spokojny rytm spotkań w swojej pracy lub zespole.</p><div class="balance-row mb-3"><span>Skupienie</span><span class="balance-track"><i></i></span><span>Odpoczynek</span></div><a class="blog-read-link mt-auto" href="/sklep/">Przejdź do sklepu <span aria-hidden="true">→</span></a></div></article></div>
        </div>
      </div>
    </section>

    <section class="quote-section"><div class="container-xl"><div class="quote-card"><span class="quote-mark" aria-hidden="true">“</span><blockquote>Dobry plan nie rozpisuje każdej minuty. Zostawia w nim miejsce dla Ciebie.</blockquote><p>FlowTImeAi · inteligentny kalendarz dla ludzi</p><div class="quote-spark" aria-hidden="true">✦</div></div></div></section>

    <section class="section faq-section" id="faq"><div class="container-xl"><div class="section-heading text-center"><span class="eyebrow">Masz pytania?</span><h2>Krótko i konkretnie</h2></div><div class="accordion faq-accordion" id="faqAccordion">
      <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqOne" aria-expanded="true" aria-controls="faqOne">Czym jest FlowTImeAi?</button></h3><div id="faqOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion"><div class="accordion-body">To koncepcja inteligentnego kalendarza oraz zestaw cyfrowych narzędzi, które łączą wydarzenia, zadania i czas dla siebie, pomagając ogarnąć cały dzień.</div></div></div>
      <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTwo" aria-expanded="false" aria-controls="faqTwo">Co znajduje się w module sklepu?</button></h3><div id="faqTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion"><div class="accordion-body">W sklepie prezentujemy poglądowe plany subskrypcji aplikacji, cyfrowe szablony tygodniowego rytmu oraz kurs online o planowaniu z pomocą AI.</div></div></div>
      <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqThree" aria-expanded="false" aria-controls="faqThree">Jak mogę zadać pytanie dotyczące oferty?</button></h3><div id="faqThree" class="accordion-collapse collapse" data-bs-parent="#faqAccordion"><div class="accordion-body">Skorzystaj z formularza kontaktowego w dolnej części strony — wybierz temat wiadomości i prześlij zapytanie.</div></div></div>
    </div></div></section>

    <section class="section blog-preview-section" id="blog" aria-labelledby="blog-preview-title">
      <div class="container-xl">
        <div class="section-heading text-center">
          <span class="eyebrow">Z dziennika FlowTImeAi</span>
          <h2 id="blog-preview-title">Pomysły na spokojniejszy <span>plan dnia.</span></h2>
          <p>Praktyczne wskazówki o planowaniu, kalendarzach i AI, które pomaga odzyskać uwagę.</p>
        </div>
        <div class="row g-4">
          {posts.slice(0, 3).map((post) => (
            <div class="col-md-6 col-lg-4">
              <article class="card blog-card h-100">
                <img class="blog-card-image" src={post.image} width="720" height="430" loading="lazy" decoding="async" alt={post.imageAlt} />
                <div class="card-body d-flex flex-column">
                  <div class="blog-meta"><span class="badge blog-category">{post.category}</span><time datetime={post.datetime}>{post.date}</time></div>
                  <h3 class="blog-card-title">{post.title}</h3>
                  <p class="blog-card-text">{post.description}</p>
                  <a class="blog-read-link mt-auto" href="/blog/single/">Czytaj dalej <span aria-hidden="true">→</span></a>
                </div>
              </article>
            </div>
          ))}
        </div>
        <div class="text-center blog-preview-cta"><a class="btn btn-outline-primary btn-lg" href="/blog/">Zobacz wszystkie publikacje <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="cta-section" id="kontakt">
      <div class="container-xl" id="early-access">
        <div class="cta-card contact-card-grid">
          <div class="cta-content">
            <span class="eyebrow">Kontakt i zapytania ofertowe</span>
            <h2>Porozmawiajmy o <span>Twoim rytmie dnia.</span></h2>
            <p>Masz pytanie o aplikację FlowTImeAi, pakiety szablonów lub wdrożenie dla zespołu? Skorzystaj z danych kontaktowych lub wyślij wiadomość przez formularz.</p>
            <dl class="contact-details-list">
              <div>
                <dt>Adres (siedziba projektu)</dt>
                <dd>ul. Akademicka 14, 00-950 Warszawa (kampus dydaktyczny)</dd>
              </div>
              <div>
                <dt>Poczta elektroniczna</dt>
                <dd><a href="mailto:kontakt@flowtimeai.edu.pl">kontakt@flowtimeai.edu.pl</a></dd>
              </div>
              <div>
                <dt>Telefon kontaktowy</dt>
                <dd><a href="tel:+48221002030">+48 22 100 20 30</a> (pn.–pt. 09:00–16:00)</dd>
              </div>
            </dl>
          </div>
          <form class="signup-form contact-form-box" id="signupForm" action="/#kontakt" method="post">
            <div class="row g-3">
              <div class="col-12">
                <label for="fullName">Imię i nazwisko</label>
                <input class="form-control" type="text" id="fullName" name="fullName" placeholder="Np. Jan Kowalski" autocomplete="name" required />
              </div>
              <div class="col-12">
                <label for="emailAddress">Adres e-mail</label>
                <input class="form-control" type="email" id="emailAddress" name="email" placeholder="name@example.com" autocomplete="email" required aria-describedby="formHint formStatus" />
              </div>
              <div class="col-12">
                <label for="inquiryTopic">Temat wiadomości</label>
                <select class="form-select" id="inquiryTopic" name="topic" required>
                  <option value="" selected disabled>Wybierz temat zapytania...</option>
                  <option value="wczesny-dostep">Wczesny dostęp do FlowTImeAi Personal</option>
                  <option value="szablony-i-kursy">Pytanie o szablony cyfrowe i kurs AI</option>
                  <option value="oferta-zespolowa">Wdrożenie pakietu FlowTImeAi Team</option>
                  <option value="inne">Inne zapytanie ofertowe</option>
                </select>
              </div>
              <div class="col-12">
                <label for="inquiryMessage">Treść zapytania</label>
                <textarea class="form-control" id="inquiryMessage" name="message" rows="4" placeholder="Opisz krótko swoje potrzeby lub pytanie..." required></textarea>
              </div>
              <div class="col-12">
                <button class="btn btn-primary w-100" type="submit">Wyślij zapytanie <span aria-hidden="true">→</span></button>
              </div>
            </div>
            <div class="form-meta">
              <span id="formHint">Formularz poglądowy — potwierdzenie wyświetla się w przeglądarce.</span>
              <span id="formStatus" role="status" aria-live="polite"></span>
            </div>
          </form>
          <div class="cta-orbit orbit-one" aria-hidden="true"></div>
          <div class="cta-orbit orbit-two" aria-hidden="true"></div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
