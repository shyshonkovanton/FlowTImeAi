---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { products, type ProductItem } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

interface Props {
  product: ProductItem;
}

const { product } = Astro.props;
const title = `${product.name} — Sklep FlowTImeAi`;
const description = product.shortDescription;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.shortDescription,
  sku: product.sku,
  category: product.category,
  image: `https://shyshonkovanton.github.io/FlowTImeAi${product.image}`,
  brand: {
    "@type": "Brand",
    name: "FlowTImeAi"
  }
};

const otherProducts = products.filter((item) => item.slug !== product.slug).slice(0, 2);
---

<BaseLayout {title} {description} canonicalPath={`/sklep/${product.slug}/`} ogImage={product.image} structuredData={productSchema}>
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <Header active="shop" />
  <main id="main">
    <article class="article-page product-page" id="top">
      <div class="container-xl">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Strona główna</a></li>
            <li class="breadcrumb-item"><a href="/sklep/">Sklep</a></li>
            <li class="breadcrumb-item active" aria-current="page">{product.name}</li>
          </ol>
        </nav>

        <div class="row gy-5 gx-0 gx-lg-5 align-items-start">
          <div class="col-lg-6">
            <figure class="article-hero mb-0">
              <img src={product.image} width="720" height="430" fetchpriority="high" decoding="async" alt={product.imageAlt} />
              <figcaption>Kod katalogowy: {product.sku} · Kategoria: {product.category}</figcaption>
            </figure>
          </div>

          <div class="col-lg-6">
            <span class="badge blog-category mb-2">{product.category}</span>
            <h1 class="product-title">{product.name}</h1>
            <p class="article-lead">{product.lead}</p>

            <div class="product-price-box">
              <div>
                <span class="product-price-label">Cena orientacyjna (projektowa)</span>
                <strong class="product-price-value">{product.price}</strong>
                <small class="d-block text-muted">{product.billingNote}</small>
              </div>
              <span class="badge shop-demo-badge">Wersja demonstracyjna</span>
            </div>

            <h2>Najważniejsze elementy pakietu</h2>
            <ul class="article-list">
              {product.features.map((feat) => (
                <li>{feat}</li>
              ))}
            </ul>

            <form class="product-order-form" id="productOrderForm" action={`/sklep/${product.slug}/`} method="post">
              <div class="row g-3 align-items-end">
                <div class="col-sm-5">
                  <label for="orderVariant">Wariant wdrożenia</label>
                  <select class="form-select" id="orderVariant" name="variant">
                    <option value="standard" selected>Standardowy dostęp online</option>
                    <option value="edukacyjny">Wariant akademicki / studencki</option>
                    <option value="konsultacja">Pakiet z konsultacją wdrożeniową</option>
                  </select>
                </div>
                <div class="col-sm-7">
                  <button class="btn btn-primary w-100" type="submit">Wybierz w wersji demonstracyjnej <span aria-hidden="true">→</span></button>
                </div>
              </div>
              <p class="product-order-status" id="productOrderStatus" role="status" aria-live="polite"></p>
            </form>
          </div>
        </div>

        <section class="product-spec-section mt-5 pt-4" aria-labelledby="spec-heading">
          <h2 id="spec-heading">Zawartość i specyfikacja pakietu</h2>
          <div class="table-responsive">
            <table class="table article-table">
              <caption>Zestawienie komponentów wchodzących w skład „{product.name}”</caption>
              <thead>
                <tr>
                  <th scope="col">Element pakietu</th>
                  <th scope="col">Forma dostarczenia</th>
                  <th scope="col">Zakres użycia</th>
                </tr>
              </thead>
              <tbody>
                {product.deliverables.map((row) => (
                  <tr>
                    <td>{row.item}</td>
                    <td>{row.format}</td>
                    <td>{row.scope}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="related-products-section mt-5 pt-4" aria-labelledby="related-heading">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h2 id="related-heading" class="m-0">Pozostałe pakiety w sklepie</h2>
            <a class="blog-read-link" href="/sklep/">Wróć do pełnego katalogu <span aria-hidden="true">→</span></a>
          </div>
          <div class="row g-4">
            {otherProducts.map((item) => (
              <div class="col-md-6">
                <article class="card blog-card h-100">
                  <div class="card-body d-flex flex-column">
                    <div class="blog-meta">
                      <span class="badge blog-category">{item.category}</span>
                      <strong>{item.price}</strong>
                    </div>
                    <h3 class="blog-card-title">{item.name}</h3>
                    <p class="blog-card-text">{item.shortDescription}</p>
                    <a class="blog-read-link mt-auto" href={`/sklep/${item.slug}/`}>Zobacz produkt <span aria-hidden="true">→</span></a>
                  </div>
                </article>
              </div>
            ))}
          </div>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
