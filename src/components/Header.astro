---
import { url } from "../lib/url";
interface Props { active?: "home" | "blog" | "shop" | "cart" | "account"; }
const { active } = Astro.props;
---

<header class="site-header">
  <nav class="navbar navbar-expand-lg" aria-label="Nawigacja główna">
    <div class="container-xl">
      <a class="navbar-brand brand" href={url("/")} aria-label="FlowTImeAi — strona główna">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><rect x="3" y="5" width="26" height="24" rx="7" fill="currentColor"/><path d="M3 12h26" stroke="white" stroke-width="2"/><path d="M10 3v5M22 3v5" stroke="white" stroke-width="2.4" stroke-linecap="round"/><circle cx="11" cy="19" r="2" fill="white"/><circle cx="18" cy="19" r="2" fill="white"/><circle cx="11" cy="25" r="2" fill="white"/></svg></span>
        <span>Flow<span class="brand-accent">TIme</span><span class="brand-ai">Ai</span></span>
      </a>
      <div class="nav-actions ms-auto ms-lg-0 order-lg-last">
        <a class:list={["nav-icon-link", { active: active === "account" }]} href={url("/konto/")} aria-label="Moje konto" aria-current={active === "account" ? "page" : undefined}><i class="bi bi-person" aria-hidden="true"></i></a>
        <a class:list={["nav-icon-link", { active: active === "cart" }]} href={url("/koszyk/")} aria-label="Koszyk, produktów: 2" aria-current={active === "cart" ? "page" : undefined}>
          <i class="bi bi-cart3" aria-hidden="true"></i>
          <span class="badge cart-badge" data-cart-count aria-hidden="true">2</span>
        </a>
      </div>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Otwórz menu"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav mx-auto my-3 my-lg-0">
          <li class="nav-item"><a class="nav-link" href={url("/#o-nas")}>O nas</a></li>
          <li class="nav-item"><a class="nav-link" href={url("/#oferta")}>Oferta</a></li>
          <li class="nav-item"><a class:list={["nav-link", { active: active === "blog" }]} href={url("/blog/")}>Blog</a></li>
          <li class="nav-item"><a class:list={["nav-link", { active: active === "shop" }]} href={url("/sklep/")}>Sklep</a></li>
          <li class="nav-item"><a class="nav-link" href={url("/#faq")}>Pytania</a></li>
          <li class="nav-item"><a class="nav-link" href={url("/#kontakt")}>Kontakt</a></li>
        </ul>
        <a class="btn btn-primary btn-nav" href={url("/#kontakt")}>Zapytaj o ofertę <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </nav>
</header>
