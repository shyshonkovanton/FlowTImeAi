---
import { url } from "../lib/url";
import { COMPANY, SOCIAL } from "../lib/site";

const year = new Date().getFullYear();
const quick = [
  { label: "Strona główna", href: "/" },
  { label: "O nas", href: "/#o-nas" },
  { label: "Oferta", href: "/#oferta" },
  { label: "Blog", href: "/blog/" },
  { label: "Kontakt", href: "/kontakt/" }
];
const client = [
  { label: "Sklep", href: "/sklep/" },
  { label: "Koszyk", href: "/koszyk/" },
  { label: "Moje konto", href: "/konto/" },
  { label: "Polityka prywatności", href: "/polityka-prywatnosci/" }
];
---

<footer class="site-footer">
  <div class="container-xl">
    <div class="footer-grid">
      <div class="footer-col footer-about">
        <a class="brand footer-brand" href={url("/")} aria-label="FlowTImeAi — strona główna">
          <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><rect x="3" y="5" width="26" height="24" rx="7" fill="currentColor"/><path d="M3 12h26" stroke="white" stroke-width="2"/><path d="M10 3v5M22 3v5" stroke="white" stroke-width="2.4" stroke-linecap="round"/><circle cx="11" cy="19" r="2" fill="white"/><circle cx="18" cy="19" r="2" fill="white"/><circle cx="11" cy="25" r="2" fill="white"/></svg></span>
          <span>Flow<span class="brand-accent">TIme</span><span class="brand-ai">Ai</span></span>
        </a>
        <p>Więcej czasu na to, co ważne. FlowTImeAi łączy spotkania, zadania i czas dla siebie w jednym inteligentnym kalendarzu. Pomagamy planować dzień spokojnie i bez presji.</p>
        <ul class="footer-social" aria-label="Media społecznościowe">
          {SOCIAL.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`FlowTImeAi — ${s.label}`}><i class={`bi ${s.icon}`} aria-hidden="true"></i></a></li>)}
        </ul>
      </div>

      <nav class="footer-col" aria-labelledby="footer-nav-title">
        <h2 class="footer-title" id="footer-nav-title">Szybka nawigacja</h2>
        <ul class="footer-links">{quick.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}</ul>
      </nav>

      <nav class="footer-col" aria-labelledby="footer-client-title">
        <h2 class="footer-title" id="footer-client-title">Strefa klienta</h2>
        <ul class="footer-links">{client.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}</ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-title" id="footer-news-title">Newsletter</h2>
        <form class="footer-newsletter" action={url("/")} method="post" data-demo-form data-success="Dziękujemy! Adres został zapisany (wersja demonstracyjna)." aria-labelledby="footer-news-title">
          <div class="input-group">
            <label class="visually-hidden" for="newsletterEmail">Adres e-mail</label>
            <input class="form-control" type="email" id="newsletterEmail" name="email" placeholder="Twój e-mail" autocomplete="email" required />
            <button class="btn btn-primary" type="submit">Zapisz się</button>
          </div>
          <p class="footer-status" role="status" aria-live="polite" data-form-status></p>
        </form>
        <ul class="footer-contact">
          <li><i class="bi bi-envelope" aria-hidden="true"></i><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></li>
          <li><i class="bi bi-telephone" aria-hidden="true"></i><a href={COMPANY.phoneHref}>Infolinia: {COMPANY.phone}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {COMPANY.name} ({COMPANY.form}). Autor projektu: Anton Shyshonkov. Wszelkie prawa zastrzeżone.</span>
      <a href={url("/polityka-prywatnosci/")}>Polityka prywatności</a>
      <a href={url("/privacy/")} lang="en">Privacy Policy (Telegram bot)</a>
      <a href="#top">Na górę ↑</a>
    </div>
  </div>
</footer>
